<?xml version="1.0" encoding="utf-8"?>
<!-- The effort question, expanded: the activity, a hint and the answers
     1–5 and 6–10 in two rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
  <TextView
      android:id="@+id/effort_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />
  <TextView
      android:id="@+id/effort_body"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textAppearance="@android:style/TextAppearance.Material.Notification" />
  <TextView
      android:id="@+id/effort_hint"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="4dp"
      android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" />
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">
    <Button
        android:id="@+id/effort_1"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:text="1"
        android:textSize="14sp" />
    <Button
        android:id="@+id/effort_2"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:text="2"
        android:textSize="14sp" />
    <Button
        android:id="@+id/effort_3"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:text="3"
        android:textSize="14sp" />
    <Button
        android:id="@+id/effort_4"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:text="4"
        android:textSize="14sp" />
    <Button
        android:id="@+id/effort_5"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:text="5"
        android:textSize="14sp" />
  </LinearLayout>
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">
    <Button
        android:id="@+id/effort_6"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:text="6"
        android:textSize="14sp" />
    <Button
        android:id="@+id/effort_7"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:text="7"
        android:textSize="14sp" />
    <Button
        android:id="@+id/effort_8"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:text="8"
        android:textSize="14sp" />
    <Button
        android:id="@+id/effort_9"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:text="9"
        android:textSize="14sp" />
    <Button
        android:id="@+id/effort_10"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:text="10"
        android:textSize="14sp" />
  </LinearLayout>
</LinearLayout>
