#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# TeamZone environments and credentials
.env
.env.*
!.env.example
**/node_modules/
**/.npm-cache/
**/.next/
*.tsbuildinfo
*.jks
*.keystore
key.properties
android/key.properties
ios/Runner/*.mobileprovision
ios/Runner/*.p12

# Supabase CLI local/link state and test credentials
supabase/.temp/
supabase/.branches/
supabase/.env
supabase/**/*.secret

# Local evidence that can contain machine-specific paths
docs/evidence/local/

# Local verification captures, exports and CLI caches
/.tmp-*
/.tmp_*
/.firebase/
